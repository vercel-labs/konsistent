{
  "name": "@konsistent/common-conventions",
  "description": "Common reusable conventions for konsistent. Authored in TypeScript via @konsistent/convention, shipped as a JSON artifact via the \"./konsistent\" exports condition.",
  "version": "0.0.1-alpha.5",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./konsistent": "./dist/conventions.json"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "konsistent-convention emit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@konsistent/convention": "workspace:*"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
