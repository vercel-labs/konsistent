{
  "name": "konsistent",
  "version": "1.0.0-beta.12",
  "description": "konsistent is a CLI tool that enforces structural conventions in TypeScript codebases.",
  "keywords": [
    "lint",
    "consistent code",
    "code conventions",
    "JavaScript",
    "TypeScript"
  ],
  "bugs": {
    "url": "https://github.com/vercel-labs/konsistent/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/konsistent",
    "directory": "packages/konsistent"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "konsistent": "./dist/cli.js"
  },
  "directories": {
    "doc": "./docs"
  },
  "files": [
    "dist",
    "docs",
    "konsistent.schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "prepack": "node --input-type=module -e \"import { cp } from 'node:fs/promises'; await cp('../../docs', './docs', { recursive: true });\"",
    "post-publish-clean": "del-cli docs",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@konsistent/convention": "workspace:*",
    "citty": "catalog:",
    "picocolors": "^1",
    "picomatch": "^4",
    "resolve.exports": "^2",
    "tinyglobby": "^0.2",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "^4",
    "ajv": "catalog:",
    "del-cli": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
