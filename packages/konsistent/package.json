{
  "name": "konsistent",
  "description": "konsistent is a CLI tool that enforces structural conventions in TypeScript codebases.",
  "version": "0.0.1-alpha.20",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "konsistent.schema.json"
  ],
  "directories": {
    "doc": "./docs"
  },
  "bin": {
    "konsistent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "prepack": "cp -r ../../docs ./docs",
    "postpack": "del-cli docs"
  },
  "dependencies": {
    "@konsistent/convention": "workspace:*",
    "citty": "catalog:",
    "picocolors": "^1",
    "resolve.exports": "^2",
    "tinyglobby": "^0.2",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "del-cli": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
