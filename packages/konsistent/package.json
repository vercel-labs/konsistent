{
  "name": "konsistent",
  "description": "konsistent is a CLI tool that enforces structural conventions in TypeScript codebases.",
  "version": "1.0.0-beta.3",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "docs",
    "konsistent.schema.json"
  ],
  "directories": {
    "doc": "./docs"
  },
  "bin": {
    "konsistent": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "prepack": "cp -r ../../docs ./docs",
    "post-publish-clean": "del-cli docs"
  },
  "dependencies": {
    "@konsistent/convention": "workspace:*",
    "citty": "catalog:",
    "picocolors": "^1",
    "resolve.exports": "^2",
    "tinyglobby": "^0.2",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "del-cli": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/konsistent",
    "directory": "packages/konsistent"
  },
  "bugs": {
    "url": "https://github.com/vercel-labs/konsistent/issues"
  },
  "keywords": [
    "lint",
    "consistent code",
    "code conventions",
    "JavaScript",
    "TypeScript"
  ]
}
