{
  "name": "konsistent",
  "description": "konsistent is a CLI tool that enforces structural conventions in TypeScript codebases.",
  "version": "0.0.1-alpha.15",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "konsistent.schema.json"
  ],
  "directories": {
    "doc": "./docs"
  },
  "bin": {
    "konsistent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "prepack": "cp -r ../../docs ./docs",
    "postpack": "del-cli docs"
  },
  "dependencies": {
    "citty": "^0.1",
    "picocolors": "^1",
    "tinyglobby": "^0.2",
    "typescript": "^5.7",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "ajv": "^8.18.0",
    "del-cli": "^6",
    "tsup": "^8",
    "tsx": "^4.21.0",
    "vitest": "^3",
    "zod-to-json-schema": "^3.25.2"
  }
}
