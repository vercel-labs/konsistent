{
  "name": "@konsistent/convention",
  "description": "Convention spec for konsistent — Zod schemas and authoring helpers for reusable conventions.",
  "version": "0.0.1-alpha.4",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "reusable-convention-package.schema.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "konsistent-convention": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "citty": "catalog:",
    "jiti": "^2"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "del-cli": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
