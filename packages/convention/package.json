{
  "name": "@konsistent/convention",
  "version": "1.0.0-beta.12",
  "description": "Convention spec for konsistent — Zod schemas and authoring helpers for reusable conventions.",
  "keywords": [
    "lint",
    "consistent code",
    "code conventions",
    "JavaScript",
    "TypeScript"
  ],
  "bugs": {
    "url": "https://github.com/vercel-labs/konsistent/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/konsistent",
    "directory": "packages/convention"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "konsistent-convention": "./dist/cli.js"
  },
  "files": [
    "dist",
    "reusable-convention-package.schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "catalog:",
    "jiti": "^2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
