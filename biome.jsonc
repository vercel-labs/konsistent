{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": ["!**/e2e/fixtures", "!**/agent-artifacts", "!**/.pnpm-store"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noTemplateCurlyInString": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
