{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["ultracite"],
  "files": {
    "ignore": ["e2e/fixtures/**", "agent-artifacts/**", ".pnpm-store/**"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noConsoleLog": "off"
      },
      "nursery": {
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
