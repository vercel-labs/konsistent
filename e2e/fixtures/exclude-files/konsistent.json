{
  "version": "v1",
  "conventions": [
    {
      "name": "plugin-exports",
      "paths": "plugins/{pluginName}/index.ts",
      "excludeFiles": ["plugins/storage/index.ts"],
      "must": {
        "export": ["activate"],
        "exportConstants": ["pluginId"]
      }
    },
    {
      "name": "plugin-tests",
      "paths": "plugins/{pluginName}",
      "must": [
        {
          "for": { "files": "{testFile}.spec.ts" },
          "excludeFiles": ["**/helpers.spec.ts"],
          "must": {
            "export": ["describe"]
          }
        }
      ]
    }
  ]
}
