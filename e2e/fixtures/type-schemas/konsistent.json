{
  "version": "v1",
  "conventions": [
    {
      "name": "type-schemas",
      "paths": "src/{harnessId}.ts",
      "must": {
        "declareTypes": [
          {
            "name": "InternalSettings",
            "schema": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "auth": "Readonly<MyAuth>"
              }
            }
          },
          {
            "name": "InternalDataSettings",
            "schema": {
              "type": "object",
              "properties": {
                "data": "${harnessId.toPascalCase()}Data"
              }
            }
          }
        ],
        "exportTypes": [
          {
            "name": "ModuleSettings",
            "schema": {
              "type": "object",
              "properties": {
                "model": { "type": "string" },
                "timeout": { "type": "number" }
              }
            }
          }
        ]
      }
    }
  ]
}
