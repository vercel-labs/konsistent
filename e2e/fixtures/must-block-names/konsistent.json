{
  "version": "v1",
  "conventions": [
    {
      "name": "component-structure",
      "paths": "components/{componentName}",
      "must": [
        { "must": { "haveFiles": ["${componentName}.tsx"] } },
        {
          "name": "test-exports",
          "if": { "hasFile": "${componentName}.test.tsx" },
          "for": { "files": "${componentName}.test.tsx" },
          "must": { "export": ["describe"] }
        },
        {
          "name": "story-meta",
          "for": { "files": "{storyFile}.stories.tsx" },
          "must": { "exportConstants": ["meta"] }
        }
      ]
    }
  ]
}
