{
  "version": "v1",
  "conventions": [
    {
      "name": "required-calls",
      "paths": "src/index.ts",
      "must": {
        "callFunction": [
          "initialize",
          {
            "name": "dispatch",
            "arguments": ["'email'", "options"]
          }
        ]
      },
      "mustNot": {
        "callFunction": ["dispatch"]
      }
    }
  ]
}
