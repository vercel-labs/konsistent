{
  "name": "konsistent-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e:run",
    "test:e2e:run": "vitest run -c e2e/vitest.config.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "publish:packages": "pnpm build && node tools/scripts/publish-packages.mjs",
    "prepare": "husky",
    "konsistent": "KONSISTENT_NO_UPDATE_CHECK=true konsistent"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "husky": "^9.1.7",
    "konsistent": "workspace:*",
    "turbo": "^2",
    "typescript": "^5.7",
    "ultracite": "^7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
