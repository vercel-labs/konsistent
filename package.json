{
  "name": "konsistent-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "typecheck": "turbo typecheck --filter='./packages/*'",
    "test": "turbo test --filter='./packages/*'",
    "test:e2e": "turbo test:e2e:run",
    "test:e2e:run": "vitest run -c e2e/vitest.config.ts",
    "check": "ultracite check",
    "check:deps": "syncpack lint",
    "fix": "ultracite fix",
    "fix:deps": "syncpack fix-mismatches && syncpack format",
    "publish:packages": "pnpm build && node tools/scripts/publish-packages.mjs",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:release": "turbo build --filter='./packages/*' && changeset publish",
    "prepare": "husky",
    "konsistent": "KONSISTENT_NO_UPDATE_CHECK=true konsistent"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@changesets/cli": "^2.31.0",
    "@felixarntz/biome": "^0.1.1",
    "husky": "^9.1.7",
    "konsistent": "workspace:*",
    "syncpack": "^15",
    "turbo": "^2",
    "typescript": "catalog:",
    "ultracite": "^7",
    "vitest": "catalog:"
  }
}
