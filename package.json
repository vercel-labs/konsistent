{
  "name": "konsistent-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e:run",
    "test:e2e:run": "vitest run -c e2e/vitest.config.ts",
    "check": "ultracite lint",
    "fix": "ultracite format",
    "publish:packages": "pnpm build && node scripts/publish-packages.js",
    "konsistent": "KONSISTENT_NO_UPDATE_CHECK=true konsistent"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "konsistent": "workspace:*",
    "turbo": "^2",
    "ultracite": "^4",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
