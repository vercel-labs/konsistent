{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#test:e2e:run": {
      "dependsOn": ["@konsistent/common-conventions#build", "konsistent#build"]
    },
    "//#check": {},
    "//#fix": {}
  }
}
